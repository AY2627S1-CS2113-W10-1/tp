@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #243247
skinparam ArrowColor #53657A
skinparam NoteBackgroundColor #FFF8DE
skinparam NoteBorderColor #BDAA65
skinparam classBorderColor #60758A
skinparam classBackgroundColor #E3F3EF
skinparam classHeaderBackgroundColor #E3F3EF
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
hide circle

title Monthly budgets and warnings (class diagram)

class AppState #E8EDF3 {
  +getBudget(): Budget
  +getExpenses(): ExpenseList
}

class Budget #E3F3EF {
  -defaultBudget: Double
  -monthlyBudgets: TreeMap<YearMonth, Double>
  +setDefault(amount: double)
  +setForMonth(month: YearMonth, amount: double)
  +getBudgetFor(month: YearMonth): Double
  +toStorageLines(): List<String>
  +loadStorageLine(line: String)
}

class BudgetChecker <<utility>> {
  +{static} WARNING_THRESHOLD_RATIO: double = 0.8
  +{static} check(budget: Budget, spent: double, month: YearMonth): String
}

abstract class Command #E2EDFC {
  +{abstract} execute(state: AppState, ui: Ui)
  +isMutating(): boolean
  +getAffectedMonth(): YearMonth
}

class SetBudgetCommand #E2EDFC {
  -amount: double
  -month: YearMonth
  +execute(state: AppState, ui: Ui)
  +isMutating(): boolean
}

class BudgetStatusCommand #E2EDFC {
  -month: YearMonth
  -today: LocalDate
  +execute(state: AppState, ui: Ui)
}

class BudgetCommandParser <<utility>> #E2EDFC {
  +{static} parse(args: String): Command
}

class ForecastCommand #E2EDFC {
  -month: YearMonth
  -today: LocalDate
  +execute(state: AppState, ui: Ui)
}

class ForecastCommandParser <<utility>> #E2EDFC {
  +{static} parse(args: String): Command
}

AppState *-- "1" Budget
Command <|-- SetBudgetCommand
Command <|-- BudgetStatusCommand
Command <|-- ForecastCommand
BudgetCommandParser ..> SetBudgetCommand : creates >
BudgetCommandParser ..> BudgetStatusCommand : creates >
ForecastCommandParser ..> ForecastCommand : creates >
SetBudgetCommand ..> Budget : updates >
BudgetStatusCommand ..> Budget : queries >
BudgetStatusCommand ..> AppState : queries expenses >
ForecastCommand ..> Budget : queries >
ForecastCommand ..> AppState : queries expenses >
BudgetChecker ..> Budget : reads >

note bottom of Budget
  TreeMap keys are sorted by YearMonth,
  guaranteeing deterministic storage output.
  getBudgetFor falls back to defaultBudget
  if no specific monthly override exists.
end note

note bottom of BudgetChecker
  Pure utility method returning warning text;
  does not depend on or invoke the UI directly.
end note

legend bottom left
  |= Colour |= Responsibility |
  |<#E8EDF3> Grey | Application orchestration |
  |<#E2EDFC> Blue | Parsing and commands |
  |<#E3F3EF> Teal | Models and calculations |
endlegend

@enduml

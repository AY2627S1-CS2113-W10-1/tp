@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #243247
skinparam ArrowColor #53657A
skinparam NoteBackgroundColor #FFF8DE
skinparam NoteBorderColor #BDAA65
skinparam classBorderColor #60758A
skinparam classBackgroundColor #E3F3EF
skinparam classHeaderBackgroundColor #E3F3EF
skinparam sequenceParticipantBorderColor #60758A
skinparam sequenceLifeLineBorderColor #A5B1BE
skinparam sequenceGroupBorderColor #8D9BAD
skinparam sequenceGroupBackgroundColor #F4F6F9
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
title Trip management and reporting (partial class diagram)
class AppState {
  +getTrips(): TripBook
  +getTrip(): Trip
  +getExpenses(): ExpenseList
}
class TripBook {
  -names: List<String>
  -selected: int = -1
  +hasCurrent(): boolean
  +getCurrent(): Trip
  +getCurrentName(): String
  +edit(index, name, start, end)
  +delete(index): String
  +toStorageLines(): List<String>
}
class Trip {
  -start: LocalDate
  -end: LocalDate
  +set(start, end)
  +contains(date): boolean
}
class ExpenseList {
  +getExpensesBetween(start, end): List<Expense>
}
class Expense {
  +getAmount(): double
}
class SplitExpense
class ForeignExpense
class ExpenseFilter {
  +{static} select(state, category, month, tripOnly): List<Expense>
}
class Statistics {
  +{static} getCategoryTotals(expenses): Map
}
class Storage #FBE7D5
AppState "1" --> "1" TripBook : trips
AppState --> ExpenseList : expenses
TripBook "1" --> "*" Trip : trips
ExpenseList --> "*" Expense
Expense <|-- SplitExpense
Expense <|-- ForeignExpense
ExpenseFilter ..> AppState
ExpenseFilter ..> ExpenseList
Statistics ..> Expense : getAmount()
Storage ..> TripBook : loads / serialises
note bottom of TripBook
  Names and trips use matching list positions.
  selected = -1 means no current trip.
  getCurrent() can return null.
end note
note bottom of ExpenseFilter
  Date-based filtering, not ownership:
  an expense may match overlapping trips.
end note
legend bottom left
  |= Colour |= Responsibility |
  |<#E8EDF3> Grey | Application orchestration |
  |<#E2EDFC> Blue | Parsing and commands |
  |<#E3F3EF> Teal | Models and calculations |
  |<#FBE7D5> Peach | Persistence |
  |<#EFE6F8> Lavender | User interface |
endlegend
@enduml
